{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "/opt/homebrew/bin/npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev",
        "--",
        "--port",
        "5190",
        "--strictPort"
      ],
      "port": 5190,
      "autoPort": false
    },
    {
      "name": "server",
      "runtimeExecutable": "/opt/homebrew/bin/node",
      "runtimeArgs": [
        "web/server/server.js"
      ],
      "port": 3000,
      "autoPort": false
    }
  ]
}